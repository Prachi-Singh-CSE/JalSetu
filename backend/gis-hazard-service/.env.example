PORT=5000
NODE_ENV=development

PGHOST=localhost
PGPORT=5432
PGDATABASE=marine_intel
PGUSER=postgres
PGPASSWORD=postgres

IMBL_BUFFER_METERS=1852
IMBL_DWELL_ESCALATION_SECONDS=300
AIS_GAP_THRESHOLD_SECONDS=900
AIS_SPEED_DROP_THRESHOLD_KNOTS=2
SAR_AIS_CORRELATION_RADIUS_KM=5

# Upstream Weather/Ocean service. Keep empty until Prachi's service is deployed.
WEATHER_OCEAN_SERVICE_URL=http://localhost:8000

# Optional Python SAR/U-Net inference service.
SAR_INFERENCE_SERVICE_URL=http://localhost:9000

# Real authority receiver supplied by the dashboard owner.
AUTHORITY_DASHBOARD_WEBHOOK_URL=
AUTHORITY_DASHBOARD_API_KEY=

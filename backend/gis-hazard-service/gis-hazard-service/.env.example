# Server
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS
PGHOST=localhost
PGPORT=5432
PGDATABASE=marine_intel
PGUSER=postgres
PGPASSWORD=changeme

# IMBL boundary alert tuning
IMBL_BUFFER_METERS=1852
IMBL_DWELL_ESCALATION_SECONDS=300

# AIS "going dark" anomaly detection
AIS_GAP_THRESHOLD_SECONDS=900
AIS_SPEED_DROP_THRESHOLD_KNOTS=2

# Authority dashboard (SOS + escalation push target)
AUTHORITY_DASHBOARD_WEBHOOK_URL=https://dashboard.example.gov.in/api/alerts
AUTHORITY_DASHBOARD_API_KEY=replace_me

# Upstream services owned by teammates (fill in once deployed)
WEATHER_OCEAN_SERVICE_URL=http://localhost:8000
AGENTIC_CORE_SERVICE_URL=http://localhost:7000

# Optional: external SAR oil-slick inference service (Python/U-Net)
# If you don't have this running yet, hazard.service.js falls back to
# reading pre-scored slick detections from the `hazard_detections` table.
SAR_INFERENCE_SERVICE_URL=http://localhost:9000
